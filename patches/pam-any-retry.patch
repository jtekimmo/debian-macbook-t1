+/// Wake-up of the main thread: one byte on a non-blocking socket pair.
+/// send(MSG_NOSIGNAL): never a SIGPIPE in the application if the read side is closed.
+struct Waker(UnixStream);
+impl Waker {
+    fn wake(&self) {
+        let b = [1u8];
+        // SAFETY: fd valid while self lives; 1-byte buffer valid.
+        unsafe {
+            libc::send(
+                self.0.as_raw_fd(),
+                b.as_ptr().cast(),
+                1,
+                libc::MSG_NOSIGNAL | libc::MSG_DONTWAIT,
+            );
+        }
+    }
+}
+
+fn drain(wake_r: &UnixStream) {
+    let mut buf = [0u8; 64];
+    loop {
+        match (&*wake_r).read(&mut buf) {
+            Ok(0) => break,
+            Ok(_) => continue,
+            Err(e) if e.kind() == ErrorKind::Interrupted => continue,
+            Err(_) => break,
+        }
+    }
+}
+
+/// poll on the wake-up and, if needed, the terminal; returns (wake-up ready, terminal ready).
+fn wait(wake_r: &UnixStream, tty: Option<&File>, timeout_ms: i32) -> (bool, bool) {
+    let mut fds = [
+        libc::pollfd { fd: wake_r.as_raw_fd(), events: libc::POLLIN, revents: 0 },
+        libc::pollfd { fd: tty.map(|t| t.as_raw_fd()).unwrap_or(-1), events: libc::POLLIN, revents: 0 },
+    ];
+    // SAFETY: valid array of 2 pollfd; fd -1 is ignored by poll.
+    let r = unsafe { libc::poll(fds.as_mut_ptr(), 2, timeout_ms) };
+    if r <= 0 {
+        return (false, false);
+    }
+    (fds[0].revents != 0, fds[1].revents != 0)
+}
+
+fn gettid() -> i32 {
+    // SAFETY: system call without argument.
+    unsafe { libc::syscall(libc::SYS_gettid) as i32 }
+}
+
+/// Blocks SIGINT in the current thread only: a SIGINT sent to this thread by
+/// pthread_kill stays pending and pam_fprintd reads it through its signalfd
+/// (do_verify: "Received signal 2 during verify", returns PAM_AUTHINFO_UNAVAIL).
+fn block_sigint_in_this_thread() {
+    // SAFETY: local sigset_t initialised by sigemptyset.
+    unsafe {
+        let mut set: libc::sigset_t = std::mem::zeroed();
+        libc::sigemptyset(&mut set);
+        libc::sigaddset(&mut set, libc::SIGINT);
+        libc::pthread_sigmask(libc::SIG_BLOCK, &set, std::ptr::null_mut());
+    }
+}
