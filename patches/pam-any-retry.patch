+struct Worker {
+    req_rx: Option<Receiver<Req>>,
+    res_tx: Option<SyncSender<Option<CString>>>,
+    result_rx: Receiver<bool>,
+    tid: Arc<AtomicI32>,
+    handle: Option<JoinHandle<()>>,
+    done: bool,
+    stop: Arc<AtomicBool>,
+}
+
+impl Worker {
+    /// Stops a losing sub-stack: SIGINT to its thread (pam_fprintd), SIGTERM
+    /// or SIGKILL to the processes this thread started (howdy's compare.py,
+    /// pam_exec, unix_chkpwd).
+    fn cancel(&self, hard: bool) {
+        let Some(handle) = &self.handle else { return };
+        // SAFETY: pthread_t valid while the thread is not joined.
+        unsafe {
+            libc::pthread_kill(handle.as_pthread_t(), libc::SIGINT);
+        }
+        let tid = self.tid.load(Ordering::SeqCst);
+        if tid <= 0 {
+            return;
+        }
+        let sig = if hard { libc::SIGKILL } else { libc::SIGTERM };
+        if let Ok(list) = std::fs::read_to_string(format!("/proc/self/task/{tid}/children")) {
+            for pid in list.split_whitespace().filter_map(|p| p.parse::<i32>().ok()) {
+                if pid > 1 {
+                    // SAFETY: pid of a child not yet waited for (zombie at worst),
+                    // hence not reused.
+                    unsafe {
+                        libc::kill(pid, sig);
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Stops and joins all threads before returning.
+fn finish(workers: &mut [Worker], wake_r: &UnixStream) {
+    for w in workers.iter_mut() {
+        w.stop.store(true, Ordering::SeqCst);
+        // A current or future prompt of a sub-stack receives CONV_ERR.
+        w.res_tx = None;
+        w.req_rx = None;
+    }
+    let start = Instant::now();
+    loop {
+        let mut alive = false;
+        for w in workers.iter_mut() {
+            let finished = match &w.handle {
+                Some(h) => h.is_finished(),
+                None => continue,
+            };
+            if finished {
+                if let Some(h) = w.handle.take() {
+                    let _ = h.join();
+                }
+            } else {
+                alive = true;
+                if !w.done {
+                    w.cancel(start.elapsed() >= KILL_AFTER);
+                }
+            }
+        }
+        if !alive {
+            return;
+        }
+        if start.elapsed() >= JOIN_LIMIT {
+            // Detached thread: it no longer touches the application's conversation
+            // (channels closed) and the module stays loaded (NODELETE).
+            for w in workers.iter_mut() {
+                w.handle.take();
+            }
+            return;
+        }
+        let _ = wait(wake_r, None, 50);
+        drain(wake_r);
+    }
+}
