+fn run(
+    conv: &Conv,
+    mode: Mode,
+    prompt_needs_tty: bool,
+    workers: &mut [Worker],
+    msg_rx: &Receiver<Msg>,
+    wake_r: &UnixStream,
+    tty: Option<&File>,
+) -> PamResultCode {
+    let total = workers.len();
+    if total == 0 {
+        return PAM_AUTH_ERR;
+    }
+    // If mode is One we count fails to know if all failed
+    // If mode is All we count successes to know if all succeeded
+    let mut count = 0;
+    let mut prompt: Option<TtyPrompt> = None;
+    let mut conv_failed = false;
+    // Reply to hand to a sub-stack: handed over only after a new
+    // pass over the results, so that a password typed when another
+    // method has already won is not verified (pam_unix: 2 s failure delay).
+    let mut deliver: Option<(usize, Option<CString>)> = None;
+    loop {
+        let mut progressed = false;
+
+        // Results first: a success does not wait for messages.
+        for i in 0..total {
+            let w = &mut workers[i];
+            if w.done {
+                continue;
