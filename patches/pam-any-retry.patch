+/// Password prompt read by the module on the terminal, withdrawable.
+struct TtyPrompt<'a> {
+    tty: &'a File,
+    worker: usize,
+    text: String,
+    buf: Vec<u8>,
+    orig: libc::termios,
+}
+
+enum TtyEvent {
+    Pending,
+    Answer(CString),
+    Abort,
+}
+
+impl<'a> TtyPrompt<'a> {
+    fn start(tty: &'a File, worker: usize, text: String) -> Option<Self> {
+        let fd = tty.as_raw_fd();
+        // SAFETY: local termios filled by tcgetattr.
+        let orig = unsafe {
+            let mut t: libc::termios = std::mem::zeroed();
+            if libc::tcgetattr(fd, &mut t) != 0 {
+                return None;
+            }
+            t
+        };
+        let mut raw = orig;
+        // No echo, no canonical line, no signals: Ctrl-C is read as a byte.
+        raw.c_lflag &= !(libc::ECHO | libc::ICANON | libc::ISIG);
+        raw.c_cc[libc::VMIN] = 1;
+        raw.c_cc[libc::VTIME] = 0;
+        // TCSAFLUSH like sudo (tgetpass): typed-ahead input is dropped.
+        // SAFETY: valid fd and termios.
+        if unsafe { libc::tcsetattr(fd, libc::TCSAFLUSH, &raw) } != 0 {
+            return None;
+        }
+        let p = TtyPrompt { tty, worker, text, buf: Vec::new(), orig };
+        p.show();
+        Some(p)
+    }
+
+    fn show(&self) {
+        let _ = (&*self.tty).write_all(self.text.as_bytes());
+    }
+
+    /// Reads what is available without blocking (VMIN=1 but poll said ready).
+    fn read(&mut self) -> TtyEvent {
+        let mut b = [0u8; 1];
+        match (&*self.tty).read(&mut b) {
+            Ok(0) => return TtyEvent::Abort,
+            Ok(_) => {}
+            Err(e) if e.kind() == ErrorKind::Interrupted => return TtyEvent::Pending,
+            Err(_) => return TtyEvent::Abort,
+        }
+        match b[0] {
+            b'\n' | b'\r' => {
+                let _ = (&*self.tty).write_all(b"\n");
+                let pw = std::mem::take(&mut self.buf);
+                match CString::new(pw) {
+                    Ok(c) => TtyEvent::Answer(c),
+                    Err(_) => TtyEvent::Abort,
+                }
+            }
+            0x7f | 0x08 => {
+                self.buf.pop();
+                TtyEvent::Pending
+            }
+            0x15 => {
+                self.buf.clear();
+                TtyEvent::Pending
+            }
+            0x03 | 0x04 => {
+                let _ = (&*self.tty).write_all(b"\n");
+                TtyEvent::Abort
+            }
+            c => {
+                self.buf.push(c);
+                TtyEvent::Pending
+            }
+        }
+    }
+
+    /// Withdrawal: another method won; the prompt line is erased.
+    fn withdraw(self) {
+        let _ = (&*self.tty).write_all(b"\r\x1b[2K");
+        // Drop restores the terminal and drops unread input.
+    }
+}
+
+impl Drop for TtyPrompt<'_> {
+    fn drop(&mut self) {
+        for b in self.buf.iter_mut() {
+            *b = 0;
+        }
+        // TCSAFLUSH: a typed but unread password remainder does not reach the shell.
+        // SAFETY: valid fd and original termios.
+        unsafe {
+            libc::tcsetattr(self.tty.as_raw_fd(), libc::TCSAFLUSH, &self.orig);
+        }
+    }
+}
