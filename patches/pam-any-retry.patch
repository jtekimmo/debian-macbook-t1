+/// Terminal on which the application authenticates: PAM_TTY must name a
+/// character device that is also standard input (sudo, su, login,
+/// pamtester -I tty=...). Excludes PAM_TTY=":0" (LightDM, xfce4-screensaver)
+/// and sudo -S (standard input is a pipe).
+fn open_auth_tty(pamh: &PamHandle) -> Option<File> {
+    let item = pamh.get_item::<Tty>().ok()??;
+    let name = item.0.to_str().ok()?;
+    if name.is_empty() {
+        return None;
+    }
+    let path = if name.starts_with('/') { name.to_string() } else { format!("/dev/{name}") };
+    let meta = std::fs::metadata(&path).ok()?;
+    if !meta.file_type().is_char_device() {
+        return None;
+    }
+    let stdin = std::fs::metadata("/proc/self/fd/0").ok()?;
+    if !stdin.file_type().is_char_device() || stdin.rdev() != meta.rdev() {
+        return None;
+    }
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .custom_flags(libc::O_NOCTTY | libc::O_CLOEXEC)
+        .open(&path)
+        .ok()?;
+    // SAFETY: valid fd.
+    if unsafe { libc::isatty(file.as_raw_fd()) } != 1 {
+        return None;
+    }
+    Some(file)
+}
