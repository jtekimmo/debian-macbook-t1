+/* gallery for the identify step of an enrolment, without the print it replaces (same user, same finger) */
+static GPtrArray *
+enroll_gallery (FprintDevice *rdev)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  GPtrArray *all = load_all_prints (rdev);
+  g_autoptr(SessionData) session = NULL;
+  guint i;
+
+  if (!priv->enroll_replace)
+    return all;
+
+  session = session_data_get (priv);
+  for (i = all->len; i > 0; i--)
+    {
+      FpPrint *pr = g_ptr_array_index (all, i - 1);
+
+      if (session && fp_print_get_finger (pr) == (FpFinger) priv->enroll_data &&
+          g_strcmp0 (fp_print_get_username (pr), session->username) == 0)
+        g_ptr_array_remove_index (all, i - 1);
+    }
+
+  return all;
+}
